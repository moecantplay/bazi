{
  "name": "@daymaster/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/generate-sw.mjs && node scripts/write-deploy-config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright install chromium && pnpm run build:e2e && playwright test",
    "e2e:looks": "playwright install chromium && pnpm run build:e2e && E2E_LOOK=trail playwright test && E2E_LOOK=almanac playwright test && E2E_LOOK=dial playwright test",
    "build:e2e": "NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=/__e2e/analytics.js NEXT_PUBLIC_ANALYTICS_SITE_ID=e2e pnpm run build"
  },
  "dependencies": {
    "@daymaster/bazi-engine": "workspace:*",
    "@daymaster/content": "workspace:*",
    "@daymaster/presentation": "workspace:*",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
