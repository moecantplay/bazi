{
  "name": "@daymaster/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/generate-sw.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "echo \"web has no unit tests; engine/content cover logic, E2E via pnpm e2e\"",
    "e2e": "playwright install chromium && pnpm run build && playwright test",
    "e2e:screenshot": "node scripts/screenshot-chart.mjs"
  },
  "dependencies": {
    "@daymaster/bazi-engine": "workspace:*",
    "@daymaster/content": "workspace:*",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
